module JoinMachines
  VERSION: String
  # Live records each input holds.
  CAPACITY: Integer

  type side = :left | :right

  # Refusals: the call was not honoured and changed nothing. Every reason has
  # its own symbol; there is no catch-all.
  type refusal = :mismatch | :pending | :late | :full | :watermark_regressed

  # The core's `Advancing`: what an accepted watermark did.
  type advancing = :advanced | :repeated

  # The core's `Side::other`: the opposite input.
  def self.other: (side) -> side

  # Every Data value is checked by the core when built, `with` included:
  # TypeError for a wrong type, RangeError for a value the core rejects
  # (an Integer outside 0..2**64-1, a side other than :left or :right).
  # Every value class is sealed: no `allocate`, subclassing raises TypeError.
  # Where the binding reads one back it takes only an instance of exactly the
  # class (TypeError otherwise) and re-validates its members (RangeError).

  # Mirrors the core's `Reach`, validated by `Reach::new`: RangeError unless
  # first <= last.
  class Reach < Data
    attr_reader first: Integer
    attr_reader last: Integer
    def self.new: (Integer first, Integer last) -> Reach
                | (first: Integer, last: Integer) -> Reach
    # The core's `contains`.
    def include?: (Integer timestamp) -> bool
  end

  # Mirrors the core's `Bounds`: any two Integers in 0..2**64-1.
  class Bounds < Data
    attr_reader before: Integer
    attr_reader after: Integer
    def self.new: (Integer before, Integer after) -> Bounds
                | (before: Integer, after: Integer) -> Bounds
    def reach: (side, Integer timestamp) -> Reach
  end

  # Mirrors the core's `Pair`: any three Integers in 0..2**64-1.
  class Pair < Data
    attr_reader key: Integer
    attr_reader left: Integer
    attr_reader right: Integer
    def self.new: (Integer key, Integer left, Integer right) -> Pair
                | (key: Integer, left: Integer, right: Integer) -> Pair
  end

  # Mirrors the core's `Record`: any three Integers in 0..2**64-1.
  class Record < Data
    attr_reader id: Integer
    attr_reader key: Integer
    attr_reader timestamp: Integer
    def self.new: (Integer id, Integer key, Integer timestamp) -> Record
                | (id: Integer, key: Integer, timestamp: Integer) -> Record
  end

  # Mirrors the core's `Retired`: TypeError unless `record` is a Record.
  class Retired < Data
    attr_reader side: side
    attr_reader record: Record
    def self.new: (side side, Record record) -> Retired
                | (side: side, record: Record) -> Retired
  end

  # Anything that reads like WindowMachines::Watermark.
  interface _Watermark
    def value: () -> Integer?
  end

  # What `Join#side_watermark` answers: a frozen copy of one input's progress.
  # `value` is nil before the first watermark, else an Integer in
  # 0..2**64-1. It satisfies `_Watermark`.
  class Watermark < Data
    attr_reader value: Integer?
    def self.new: (Integer? value) -> Watermark
                | (value: Integer?) -> Watermark
  end

  class Join
    def self.new: (Bounds bounds) -> Join
    def bounds: () -> Bounds
    def capacity: (side) -> Integer
    # Live records held for one input (the core's `len`).
    def size: (side) -> Integer
    def empty?: () -> bool
    # The core's `contains`.
    def include?: (side, Integer id) -> bool
    # Honoured: :accepted, or :duplicate (the core's `Inserting`) when exactly
    # this record is already held on that side: nothing changes and no pair is
    # owed twice. Refused: :mismatch (the id is held with another key or
    # timestamp), :pending, :late (at or below its own side's watermark; the
    # other side's watermark never makes a record late), :full. A held id is
    # answered first.
    def insert: (side, Record record) -> (:accepted | :duplicate | :mismatch | :pending | :late | :full)
    def pending?: () -> bool
    def pending_pairs: () -> Integer
    # At most `max` owed pairs, [] when none is owed. Never refuses. A raise
    # while building the answer drains nothing; FrozenError if building it
    # froze the join, RuntimeError if it changed it; nothing drained.
    def drain: (Integer max) -> Array[Pair]
    # Honoured: :advanced, and :repeated when the side already held exactly
    # `value` (nothing changes). Refused: :watermark_regressed.
    def advance_watermark: (side, Integer value) -> (advancing | :watermark_regressed)
    # Reads this gem's Watermark natively (TypeError for a subclass of it),
    # any other object through `value`; FrozenError, nothing advanced, if
    # `value` froze the join. Honoured: :advanced, and :repeated when the side
    # already equals it, a nil value against a side with no watermark
    # included. Refused: :watermark_regressed, a nil value against a side that
    # holds one included.
    def advance_watermark_from: (side, _Watermark watermark) -> (advancing | :watermark_regressed)
    # The side's watermark as an Integer, nil before the first.
    def watermark: (side) -> Integer?
    # The same state as a Watermark value, never nil itself.
    def side_watermark: (side) -> Watermark
    # Held records both watermarks have finished: the other side's is at or
    # past the end of the record's reach, and its own is at or past its
    # timestamp (so a replay of it is :late).
    def retirable: () -> Integer
    # Honoured: the retired records, [] when none is retirable. Refused: :pending.
    # A raise while building the answer retires nothing; FrozenError if
    # building it froze the join, RuntimeError if it changed it; nothing
    # retired.
    def retire: (Integer max) -> (Array[Retired] | :pending)
  end
end
